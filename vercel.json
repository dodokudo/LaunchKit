{
  "buildCommand": "npm run build:deploy",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/8m/assets/ai-threads-ogp-1200x630-v3-fast.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/funnel",
      "destination": "https://funnel-kudos-projects-0bee12bb.vercel.app/funnel/"
    },
    {
      "source": "/funnel/(.*)",
      "destination": "https://funnel-kudos-projects-0bee12bb.vercel.app/funnel/$1"
    }
  ]
}
